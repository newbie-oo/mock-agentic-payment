        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "THB satang, 100 per baht"
          },
          "currency": {
            "default": "THB",
            "type": "string",
            "const": "THB"
          },
          "customer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "methods": {
            "default": [
